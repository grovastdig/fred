# ============================================================
# FRED — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Anthropic (Fred's Brain) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Telegram (replaces Twilio — free forever) ────────────────────────────────
# 1. Open Telegram → search @BotFather → /newbot → name it Fred
# 2. Copy the token BotFather gives you
# 3. Start a chat with your bot — first message gives you the chat_id
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here

# ── Notion (Portfolio Database + Fred's Brain) ───────────────────────────────
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx
NOTION_POSITIONS_DB_ID=           # filled by setup_notion.py
NOTION_WATCHLIST_DB_ID=           # filled by setup_notion.py
NOTION_JOURNAL_DB_ID=             # filled by setup_notion.py
NOTION_RULES_PAGE_ID=             # filled by setup_notion.py
NOTION_ALERT_LOG_DB_ID=           # filled by setup_notion.py
NOTION_SOCIAL_TRIGGERS_DB=        # filled by setup_notion.py
NOTION_FREDS_BRAIN_PAGE_ID=       # filled by setup_notion.py

# ── Alpaca (Paper Trading Mirror) ─────────────────────────────────────────────
ALPACA_API_KEY=your-alpaca-api-key
ALPACA_SECRET_KEY=your-alpaca-secret-key
# Leave as paper URL — Fred NEVER trades real money
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ── Twitter/X (Social Monitor) ────────────────────────────────────────────────
# Option A: Official API ($100/mo Basic tier) — real-time
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Option B: Free scraper mode — set to true, no keys needed (~2-5 min delay)
TWITTER_USE_SCRAPER=true

# ── Market Data ────────────────────────────────────────────────────────────────
# Polygon.io (optional but recommended — free tier works)
POLYGON_API_KEY=
# yfinance is used as default (no key needed)

# ── News (optional) ────────────────────────────────────────────────────────────
# NewsAPI.org — free tier (100 req/day), better news coverage
NEWSAPI_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
TIMEZONE=America/New_York

# ── Schedule Times (24hr ET) ─────────────────────────────────────────────────
MORNING_BRIEF_TIME=08:30
EOD_DEBRIEF_TIME=16:30
SUNDAY_SYNC_TIME=19:00
